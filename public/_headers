# Cabeceras de seguridad para todas las páginas (Cloudflare Pages lee este archivo).
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Los archivos compilados llevan un código en el nombre: se pueden guardar en caché para siempre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
